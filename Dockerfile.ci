FROM composer:2 AS composer
FROM blackfire/blackfire:2 AS blackfire
FROM ghcr.io/symfony-cli/symfony-cli:latest AS symfony-cli
FROM php:8.4-fpm-alpine

LABEL org.opencontainers.image.source=https://github.com/openaction/docker-php

ARG NODE_VERSION=22
ARG NVM_VERSION=v0.40.7

ENV AMQP_VERSION=2.1.2 \
    APCU_VERSION=5.1.24 \
    REDIS_VERSION=6.2.0 \
    TZ=UTC \
    PANTHER_CHROME_BINARY=/usr/bin/chromium-browser \
    COMPOSER_ALLOW_SUPERUSER=1 \
    BLACKFIRE_AGENT_SOCKET=unix:///var/run/blackfire/agent.sock \
    BLACKFIRE_SOCKET=unix:///var/run/blackfire/agent.sock \
    BLACKFIRE_ENDPOINT=https://blackfire.io \
    BLACKFIRE_LOG_LEVEL=1 \
    BLACKFIRE_LOG_FILE= \
    BLACKFIRE_DISABLE_PCOV=1 \
    BASH_ENV=/etc/profile.d/nvm.sh \
    NVM_DIR=/opt/nvm \
    NVM_NODEJS_ORG_MIRROR=https://unofficial-builds.nodejs.org/download/release \
    PATH=/opt/nvm/current/bin:$PATH

COPY conf/install-blackfire.sh /usr/local/bin/install-blackfire
COPY conf/start-blackfire-agent.sh /usr/local/bin/start-blackfire-agent
COPY conf/start-php-fpm.sh /usr/local/bin/start-php-fpm
COPY conf/nvm.sh /etc/profile.d/nvm.sh

RUN apk add --no-cache --virtual .persistent-deps \
        bash \
        binutils \
        ca-certificates \
        chromium \
        chromium-chromedriver \
        coreutils \
        curl \
        docker-cli \
        docker-cli-buildx \
        docker-cli-compose \
        findutils \
        g++ \
        gcc \
        git \
        gmp-dev \
        grep \
        icu-libs \
        icu-data-full \
        jq \
        libgcc \
        libpq \
        libstdc++ \
        linux-headers \
        make \
        mysql-client \
        nano \
        nginx \
        openssh-client \
        openssl \
        patch \
        postgresql-client \
        poppler \
        poppler-utils \
        procps \
        python3 \
        rsync \
        supervisor \
        unzip \
        util-linux \
        wget \
        zip \
        zlib

RUN set -xe \
    && chmod +x /usr/local/bin/install-blackfire /usr/local/bin/start-blackfire-agent /usr/local/bin/start-php-fpm \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        freetype \
        freetype-dev \
        gnu-libiconv \
        icu-dev \
        jpeg-dev \
        libpng \
        libpng-dev \
        libjpeg \
        libjpeg-turbo \
        libjpeg-turbo-dev \
        libwebp-dev \
        libxslt-dev \
        libzip-dev \
        postgresql-dev \
        rabbitmq-c-dev \
        sqlite-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-configure intl \
    && docker-php-ext-install \
        bcmath \
        exif \
        fileinfo \
        gd \
        gmp \
        intl \
        pcntl \
        pdo_mysql \
        pdo_pgsql \
        pdo_sqlite \
        xsl \
        zip \
    && pecl install \
        amqp-${AMQP_VERSION} \
        apcu-${APCU_VERSION} \
        redis-${REDIS_VERSION} \
        pcov \
    && docker-php-ext-enable --ini-name 75-amqp.ini amqp \
    && docker-php-ext-enable --ini-name 80-apcu.ini apcu \
    && docker-php-ext-enable --ini-name 85-redis.ini redis \
    && docker-php-ext-enable --ini-name 90-pcov.ini pcov \
    && install-blackfire \
    && runDeps="$( \
        scanelf --needed --nobanner --format '%n#p' --recursive /usr/local/lib/php/extensions \
            | tr ',' '\n' \
            | sort -u \
            | awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }' \
    )" \
    && apk add --no-cache --virtual .php-phpexts-rundeps $runDeps \
    && apk del .build-deps \
    && mkdir -p /run/nginx/ \
    && mkdir /etc/periodic/1min

COPY --from=composer /usr/bin/composer /usr/bin/composer
COPY --from=blackfire /usr/local/bin/blackfire /usr/local/bin/blackfire
COPY --from=symfony-cli /usr/local/bin/symfony /usr/local/bin/symfony
COPY conf/php-ci.ini /usr/local/etc/php/php.ini
COPY conf/www.conf /usr/local/etc/php-fpm.d/www.conf
COPY conf/nginx.conf /etc/nginx/nginx.conf
COPY conf/supervisord.conf /usr/local/etc/supervisord.conf

RUN git clone --depth 1 --branch "${NVM_VERSION}" https://github.com/nvm-sh/nvm.git "${NVM_DIR}" \
    && . "${BASH_ENV}" \
    && nvm install "${NODE_VERSION}" \
    && nvm alias default "${NODE_VERSION}" \
    && nvm use default \
    && corepack enable yarn \
    && ln -s "$(dirname "$(dirname "$(nvm which default)")")" "${NVM_DIR}/current" \
    && composer --version \
    && symfony version \
    && node --version \
    && npm --version \
    && yarn --version \
    && docker --version \
    && docker buildx version \
    && docker compose version \
    && php -r 'echo date_default_timezone_get();' \
    && chromium-browser --version \
    && chromedriver --version

EXPOSE 80

WORKDIR /app
CMD ["supervisord", "--configuration", "/usr/local/etc/supervisord.conf"]
